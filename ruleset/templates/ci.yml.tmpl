# {{ .Module }} 的 CI：全部步骤在 appkit 的 reusable workflow 中维护。
name: ci

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

jobs:
  ci:
    # appkit {{ .Version }}；完整 SHA 由 sync 从该版本的 Go module provenance 解析。
    uses: forgeplex/appkit/.github/workflows/domain-ci.yml@{{ .WorkflowRef }}
