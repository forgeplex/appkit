# go-arch-lint v3 配置，由 appkit sync 物化；本地改动会被 CI 漂移检查拒绝。
# 方向性约束矩阵（docs/DESIGN.md §4）：transport 只进不出，业务包零内部依赖。
version: 3
workdir: internal
allow:
  # 第三方依赖的限制由 depguard 承担，这里只管内部拓扑。
  depOnAnyVendor: true
  # deepScan 追依赖注入的实参流向，与组合根模式天然冲突：
  # internal/module 把 postgres.NewStore(...) 注入 {{ .Domain }}.NewService(...)
  # 会被判成「domain 依赖 postgres」——而这恰恰是 wiring 的定义。
  # import 层的方向矩阵（下面的 deps）已经拦住真正的越界，不靠 deepScan。
  deepScan: false
  # 允许尚未建出的组件目录（如暂无 inbox 的域）。
  ignoreNotFoundComponents: true
components:
  domain:
    in:
      - "{{ .Domain }}"
      - "{{ .Domain }}/**"
  postgres:
    in:
      - postgres
      - postgres/**
  http:
    in:
      - http
      - http/**
  inbox:
    in:
      - inbox
      - inbox/**
  module:
    in:
      - module
      - module/**
deps:
  # domain 不出现在 deps：internal/{{ .Domain }} 不得依赖任何内部组件。
  postgres:
    mayDependOn:
      - domain
  http:
    mayDependOn:
      - domain
  inbox:
    mayDependOn:
      - domain
  module:
    mayDependOn:
      - domain
      - postgres
      - http
      - inbox
