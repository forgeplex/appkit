# Code generated by appkit sync (v1.2.3). DO NOT EDIT.
# golangci-lint v2 配置，由 appkit sync 物化；本地改动会被 CI 漂移检查拒绝。
version: "2"

linters:
  # standard 组默认启用 errcheck / govet / staticcheck / ineffassign / unused。
  default: standard
  enable:
    - bidichk
    - bodyclose
    - contextcheck
    - depguard
    - durationcheck
    - errchkjson
    - errorlint
    - exhaustive
    - fatcontext
    - forbidigo
    - gosec
    - modernize
    - nilerr
    - nilnil
    - noctx
    - nolintlint
    - rowserrcheck
    - sloglint
    - sqlclosecheck
    - wrapcheck
  settings:
    depguard:
      rules:
        # internal/ledger 是纯业务包，零 infra import（docs/DESIGN.md §4）。
        domain:
          list-mode: lax
          files:
            - "**/internal/ledger/**"
          deny:
            - pkg: github.com/jackc/pgx
              desc: 业务包禁止 import pgx；数据访问经 store 接口，实现放 internal/postgres
            - pkg: github.com/gin-gonic
              desc: 业务包禁止依赖 gin；transport 放 internal/http
            - pkg: net/http
              desc: 业务包禁止依赖 net/http；HTTP 细节放 internal/http
        # pgx 只允许出现在 internal/postgres（repo 层外无 SQL）。
        # 组合根除外：cmd/ 与 internal/module 是连接池的注入与分发点
        # （store/relay/迁移器都在这里装配），它们持有句柄，但不写 SQL。
        pgx-only-in-postgres:
          list-mode: lax
          files:
            - "!**/internal/postgres/**"
            - "!**/internal/module/**"
            - "!**/cmd/**"
          deny:
            - pkg: github.com/jackc/pgx
              desc: pgx 只允许出现在 internal/postgres；其余包经 internal/ledger 的接口访问数据
    exhaustive:
      # 带 default 分支的 switch 视为已穷举，只拦真正漏分支且无兜底的枚举 switch。
      default-signifies-exhaustive: true
    gosec:
      excludes:
        # G104 与标准组 errcheck 重复，避免同一处漏查错误报两条。
        - G104
    sloglint:
      # 禁止调用全局 slog.Info/Warn/Error 等默认 logger，日志一律走注入的 *slog.Logger。
      no-global: all
    wrapcheck:
      # 本框架的错误词汇是 apperr（错误身份 = 错误码，DESIGN §5.2），不是
      # fmt.Errorf("%w")：appkit 交回的错误已在边界归一化为 *apperr.Error
      # （tx.Do 原样返回回调自己的错误，contract.Call 出口做归一化），
      # 再包一层只会把错误码埋进 message，让 apperr.Is 认不出来。
      # 驱动错误同理：把 pgx/sqlc 的错误翻译成域错误是 internal/postgres 的
      # 职责，逐个 Scan/Exec 套 fmt.Errorf 只会逼出满仓 //nolint。
      # 域内部同理：错误在 internal/ledger/** 之间流动时早已是 *apperr.Error，
      # 一路加前缀只会让同一个错误码顶着五层"查会话: 取令牌: ..."的壳出去。
      # 放行的只有这四类——其余外部包的错误原样漏出照报（internal/postgres 里也报）。
      ignore-package-globs:
        - github.com/forgeplex/appkit**
        - github.com/jackc/pgx/**
        - github.com/forgeplex/ledger/internal/postgres/sqlc
        - github.com/forgeplex/ledger/internal/ledger/**
      # 业务包调用自己定义的 Store / Publisher 接口是标准形态：把驱动错误
      # 翻译成域错误是实现方（internal/postgres）的职责，不是调用点的。
      #
      # 这条只覆盖域根包：wrapcheck 拿来匹配的是「包名.接口名」，不是导入路径，
      # 所以子包（ledger/session 之类）里的接口写不进这个正则——它们由上面
      # 那条 ignore-package-globs 兜住。
      ignore-interface-regexps:
        - ^ledger\.
    forbidigo:
      forbid:
        - pattern: '^fmt\.Print.*$'
          msg: 禁用 fmt.Print*；日志走注入的 slog
        - pattern: '^time\.(NewTicker|Tick)$'
          msg: 禁用裸 time.Ticker/Tick；周期任务走 reg.Worker + job.Every（多副本 advisory lock）
        - pattern: '^http\.Error$'
          msg: 禁用 http.Error；错误响应统一走 httpserver.WriteError（RFC 9457）
        - pattern: '^http\.(Get|Post|PostForm|Head|DefaultClient|DefaultTransport)$'
          msg: 禁用默认全局 HTTP 客户端；请显式构造带超时与 callctx.Transport / NewSecureClient 的客户端
        - pattern: '^os\.Exit$'
          msg: 禁用 os.Exit；进程生命周期与优雅关停统一由 bootstrap.Main / App.Run 托管
        - pattern: '^log\.(Fatal|Fatalf|Fatalln|Panic|Panicf|Panicln)$'
          msg: 禁用 log.Fatal*/Panic*；错误请返回上层，日志走注入的 slog
        - pattern: '^http\.ListenAndServe.*$'
          msg: 禁用裸 http.ListenAndServe*；HTTP Listener 与安全边界统一由 appkit 托管
        - pattern: '^signal\.Notify.*$'
          msg: 禁用自建 signal.Notify*；OS 信号处理统一由 App.Run / bootstrap.Runner 拥有
    nolintlint:
      allow-unused: false
      require-explanation: true
      require-specific: true
  exclusions:
    # sqlc / 合约生成物不 lint（生成物禁手改由 CI drift check 保证）。
    generated: lax
    rules:
      # 测试代码放宽错误包裹、打印与安全扫描限制。
      - path: _test\.go
        linters:
          - wrapcheck
          - forbidigo
          - gosec
