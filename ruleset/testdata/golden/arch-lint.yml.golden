    in:
      - module
      - module/**
deps:
  # domain 不出现在 deps：internal/ledger 不得依赖任何内部组件。
  postgres:
    mayDependOn:
      - domain
  http:
    mayDependOn:
      - domain
  inbox:
    mayDependOn:
      - domain
  module:
    mayDependOn:
      - domain
      - postgres
      - http
      - inbox
