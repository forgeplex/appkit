# {{.Name}} 生产环境配置。密钥不进配置文件，一律走 {{.EnvPrefix}}_* 环境变量注入。
addr: ":8080"
env: prod
security:
  # 必须按该部署的暴露面显式选择严格模式，留空会在监听端口前失败；不能以
  # disabled 绕过生产身份边界。user_facing 需要用户公钥与 issuer；
  # internal_service/mixed 需要 security.service 或 ServiceVerifier，缺失时 fail closed。
  mode: ""
database:
  # 生产库地址含密钥，走 {{.EnvPrefix}}_DATABASE__URL 环境变量注入，此处留空。
  url: ""
log:
  level: info
  format: json
debug:
  # pprof 排障端点默认关闭；user_facing 模式禁止启用。internal_service/mixed
  # 下端点必须由已验证的服务身份保护。
  pprof: false
