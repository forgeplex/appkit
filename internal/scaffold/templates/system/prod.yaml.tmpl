# {{.Name}} 生产环境配置。密钥不进配置文件，一律走 {{.EnvPrefix}}_* 环境变量注入。
addr: ":8080"
env: prod
database:
  # 生产库地址含密钥，走 {{.EnvPrefix}}_DATABASE__URL 环境变量注入，此处留空。
  url: ""
log:
  level: info
  format: json
debug:
  # pprof 排障端点默认关闭。生产开启（排障时改配置重启即可，不必发版）前
  # 先确认服务端口不暴露公网：/debug/pprof/* 泄露 goroutine 栈与堆内容。
  pprof: false
