// Command {{.Name}} 是组合根：只做 wiring + 配置 + 部署，零业务逻辑
// （DESIGN §5）。同一二进制以不同 -target 部署，即得 modular monolith ↔
// 微服务切换——部署形态是启动参数，不是架构决策。
//
// 启动装配（配置加载/遥测/连接池/事件总线/迁移器/优雅关停）在
// appkit/bootstrap 里，位于 module cache（只读），改不到也不必读。
// 这里只声明两件事：装哪些域模块、target 之外的契约绑谁。
package main

import (
	"github.com/forgeplex/appkit"
	"github.com/forgeplex/appkit/bootstrap"
)

func main() {
	bootstrap.Main(bootstrap.Options{
		Service: "{{.Name}}",
		// 各域模块在此装配（go.mod require 对应域 repo 后取消注释）。
		// d.Pool 是各域共用的连接池（按库共享而非按模块独占，防连接数
		// 爆炸，DESIGN §8）；d.Bus 是事件总线，relay 与消费者共用同一个。
		Modules: func(d bootstrap.Deps) ([]appkit.Module, error) {
			return []appkit.Module{
				// ledger.Module(ledger.Options{Log: d.Log, Pool: d.Pool, Bus: d.Bus}),
				// gateway.Module(gateway.Options{Log: d.Log, Pool: d.Pool, Bus: d.Bus}),
			}, nil
		},
		// 未配置 database.url 时只起探针：刚 new 出来还没 require 任何域仓库，
		// make run 也能证明服务能起。装上域模块后配 database.url 走完整模式。
		Minimal: func(bootstrap.Deps) ([]appkit.Module, error) { return nil, nil },
		// target 之外的契约自动落到 Remote 绑定（合约仓库生成的 HTTP client，
		// 实现同一接口）——消费方代码在单体与微服务下完全一致。
		//
		// AppOptions: func(bootstrap.Deps) []appkit.Option {
		// 	return []appkit.Option{
		// 		appkit.Remote(ledgerv1.NewClient),
		// 		appkit.Remote(authv1.NewClient),
		// 	}
		// },
		//
		// 拆分部署换 NATS/Kafka 总线时（同一接口，业务代码不改）：
		// NewBus: func() bootstrap.EventBus { return natsbus.New(...) },
	})
}
