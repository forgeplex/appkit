# {{.Name}}d 开发配置。任意键可被 {{.EnvPrefix}}_* 环境变量覆盖
# （双下划线是层级分隔符：{{.EnvPrefix}}_DATABASE__URL 覆盖 database.url）。
addr: ":8080"
env: dev
security:
  # bootstrap 仅允许 env=dev 显式关闭；staging/prod 会拒绝 disabled。
  mode: disabled
log:
  level: debug
  format: text
database:
  # 留空时正常启动会 fail closed；零依赖试跑必须显式 make run-minimal。
  # 完整模式：make dev-db 启动一次性 Postgres 后，取消下一行注释（或 make run-db 直接以环境变量注入）。
  # url: postgres://postgres:dev@127.0.0.1:54329/{{.Name}}_dev?sslmode=disable
  url: ""
debug:
  # disabled 模式下 pprof 无身份保护，只能在可信本机临时打开；严格模式仅
  # internal_service/mixed 可启用，并要求已验证的服务身份。
  pprof: false
