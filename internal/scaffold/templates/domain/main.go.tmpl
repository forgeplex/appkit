// Command {{.Name}}d 是 {{.Name}} 域的独立部署入口：只装本域模块。
//
// 启动装配（配置加载/遥测/连接池/事件总线/迁移器/优雅关停）全部在
// appkit/bootstrap 里——那段代码在 module cache 里只读，改不到也不必读。
// 这里只声明两件事：装哪些模块、外域契约绑谁。
package main

import (
	"net/http"

	"github.com/forgeplex/appkit"
	"github.com/forgeplex/appkit/bootstrap"

	{{.Name}} "{{.Module}}"
	{{.Name}}http "{{.Module}}/internal/http"
)

func main() {
	bootstrap.Main(bootstrap.Options{
		Service: "{{.Name}}d",
		Modules: func(d bootstrap.Deps) ([]appkit.Module, error) {
			return []appkit.Module{
				{{.Name}}.Module({{.Name}}.Options{Log: d.Log, Pool: d.Pool, Bus: d.Bus{{if .Partitioned}},
					// 演示分区映射：已验证分区键 "tenant" → schema "{{.Name}}_tenant"；
					// 与行级租户 TenantID 独立，不能直接信任 unsigned 请求头。
					// 真实部署改成从本服务的配置文件读取注入（config.Load 支持
					// map[string]string），例如三体系：
					//   {"merchant": "rbac_merchant", "ops": "rbac_ops", "agent": "rbac_agent"}
					Schemas: map[string]string{"tenant": "{{.Name}}_tenant"},
				{{end}}}),
			}, nil
		},
		Minimal: minimal,
		// 外域契约绑远程 client（合约仓库生成，实现同一契约接口）：
		// 提供方在 -target 内就走进程内直调，不在就走这里的 client——
		// 消费方代码两种形态下完全一致。
		//
		// AppOptions: func(bootstrap.Deps) []appkit.Option {
		// 	return []appkit.Option{
		// 		appkit.Remote[otherv1.Service](func(*appkit.Registry) (otherv1.Service, error) {
		// 			return otherv1.NewSecureClient(endpoint, secureOptions)
		// 		}),
		// 	}
		// },
		// endpoint 必须为 HTTPS；secureOptions 是 contract.SecureClientOptions，
		// 显式提供 Audience 与授权后签发短期服务 JWT 的 Credentials。
		// 接收端配置 security.service，契约入口使用 MountInternalService。
		// 用户 Authorization 不自动转发，TenantID/Partition 由签名委托重建。
	})
}

// minimal 是显式 -minimal 时的占位模块：证明服务能跑，不装任何业务。
// 路由与完整模块同一 pattern——切换模式不移动端点。
func minimal(bootstrap.Deps) ([]appkit.Module, error) {
	return []appkit.Module{
		appkit.ModuleFunc("{{.Name}}", func(reg *appkit.Registry) error {
			reg.MountPublic({{.Name}}http.PingPattern, http.HandlerFunc(
				func(w http.ResponseWriter, _ *http.Request) {
					_, _ = w.Write([]byte("pong (最小模式)\n"))
				}))
			return nil
		}),
	}, nil
}

