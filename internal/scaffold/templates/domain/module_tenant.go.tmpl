// Package module 是装配层：把业务包、postgres、http、inbox 装进
// appkit.Registry。这是本仓库唯一的 wiring 落点——驱动类型（连接池）
// 从组合根注入，到此为止，不再向业务包扩散。
//
// 租户域（tenant）：单 schema、行级隔离。租户身份经 callctx 传播
// （authn 从令牌 tid 焊入），每次事务由 pgtx.NewTenant 落成事务级
// GUC app.tenant_id，业务表的 RLS 策略据此过滤——隔离在存储层强制，
// 漏写 WHERE 不再是跨租户泄漏（见 db/migrations/0002 的样例与
// docs/GUIDE.md 租户章节）。
package module

import (
	"context"
	"io/fs"
	"log/slog"
	"net/http"

	"github.com/jackc/pgx/v5/pgxpool"

	"github.com/forgeplex/appkit"
	"github.com/forgeplex/appkit/health"
	"github.com/forgeplex/appkit/outbox"
	"github.com/forgeplex/appkit/pgtx"

	"{{.Module}}/internal/{{.Name}}"
	{{.Name}}http "{{.Module}}/internal/http"
	"{{.Module}}/internal/postgres"
)

// Schema 是本域独占的 Postgres schema（= 域名，DESIGN §8）。
// 迁移只允许操作本 schema；跨 schema 引用由 appkit check 拒绝。
// 租户共用这一个 schema，隔离靠行级（tenant_id + RLS），不靠 schema 拆分。
const Schema = "{{.Name}}"

// Options 是装配期依赖，由组合根注入（连接池按数据库共享，DESIGN §8）。
type Options struct {
	Log  *slog.Logger
	Pool *pgxpool.Pool
	// Bus 是事件总线（单体单库用 outbox.NewDirectBus()，拆分部署换 NATS/Kafka
	// 实现）。非 nil 时模块自带 outbox relay：本域事件自动外发。
	// 组合根应把同一个实例传给全部模块并注入 appkit.Bus(bus)。
	Bus outbox.Bus
}

// New 构造模块。migrations 是 db/migrations 的 embed FS（由根包注入）。
func New(opts Options, migrations fs.FS) appkit.Module {
	return &mod{opts: opts, migrations: migrations}
}

type mod struct {
	opts       Options
	migrations fs.FS
	// handler 在 Setup 阶段装配（依赖解析之后）；Mount 必须发生在 Register
	// 阶段，因此路由经一层间接引用——Setup 先于 HTTP 监听，不会打到 nil。
	handler http.Handler
}

func (m *mod) Name() string { return "{{.Name}}" }

// Register 只做声明：Provide 服务、登记迁移 / 路由 / 健康检查（DESIGN §5.1）。
func (m *mod) Register(reg *appkit.Registry) error {
	// 租户 Transactor：每次 Do 开事务后把 callctx 里的租户身份落成事务级
	// GUC（app.tenant_id），连接归池即净。业务表的 RLS 策略读它过滤行——
	// 一切业务查询照旧经 tx.Do（骨架的既有形态就是），不在这一层做任何
	// 特判。
	appkit.Provide(reg, func(*appkit.Registry) (*{{.Name}}.Service, error) {
		return {{.Name}}.NewService(
			postgres.NewStore(m.opts.Pool),
			pgtx.NewTenant(m.opts.Pool),
			outbox.NewPublisher(m.opts.Pool, Schema),
		), nil
	})
	// 对外契约（psp-contracts 生成后）改用 appkit.ProvideContract +
	// 生成的 wrapper 注册：每次跨模块调用都经 contract.Call（DESIGN §5.3）。

	reg.Migrations(Schema, m.migrations)

	// 权限码声明：汇总进全应用目录，鉴权提供方（如 rbac）据此把目录同步
	// 落库。端点绑码用 reg.Require("{{.Name}}:read", handler)——判定语义
	// 统一在框架（401/403/step-up），模块不各自实现；高危码在声明里带
	// Challenge: true。验签中间件（authn.Middleware）是组合根的部署面
	// 决策，见 docs/GUIDE.md 鉴权章节。
	reg.Permissions(appkit.PermissionDecl{
		Code: "{{.Name}}:read", Name: "读取", Category: "{{.Name}}",
	})

	reg.Setup(func(ctx context.Context) error {
		// 迁移已应用（Setup 晚于迁移），此时校验租户隔离的完整性：
		// 有 tenant_id 列的表必须 ENABLE+FORCE+挂策略，且连接角色不得
		// superuser/BYPASSRLS——否则 RLS 静默不生效，等于裸奔。缺一样
		// 都拒绝启动，错误信息点名表并附修复 SQL。
		if err := pgtx.VerifyTenantRLS(ctx, m.opts.Pool, Schema); err != nil {
			return err
		}
		svc := appkit.MustResolve[*{{.Name}}.Service](reg)
		m.handler = {{.Name}}http.NewPingHandler(m.opts.Log, svc)
		// 消费外域事件样例（声明后组合根必须以 appkit.Bus 注入总线）。
		// 事件 meta 沿调用链带着租户身份（callctx 已传播），handler 内
		// 照常 tx.Do 即落对租户：
		// reg.Consumer("other.something.v1",
		//     outbox.Inbox(m.opts.Pool, Schema, inbox.Consumer, inbox.NewHandler(svc)))
		return nil
	})
	reg.Mount({{.Name}}http.PingPattern, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		m.handler.ServeHTTP(w, r)
	}))

	reg.Health("postgres", health.CheckFunc(func(ctx context.Context) error {
		return m.opts.Pool.Ping(ctx)
	}))

	// outbox relay：轮询本域 outbox 表并经 Bus 外发（退避/死信见 outbox 包文档）。
	// reg.Worker 管住 goroutine 的三件事——关停等它退出、超预算不吊死、
	// 崩了掀翻进程而不是让探针继续绿着——都在框架里，这里只交一个函数。
	if m.opts.Bus != nil {
		relay := outbox.NewRelay(m.opts.Pool, Schema, m.opts.Bus)
		reg.Worker("outbox-relay", relay.Run)
	} else {
		m.opts.Log.Warn("{{.Name}}: 未注入 Bus，outbox relay 未启动——本域事件只落表不外发")
	}
	return nil
}
