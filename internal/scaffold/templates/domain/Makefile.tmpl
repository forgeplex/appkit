# {{.Name}} 域仓库开发入口。
# lint/CI 配置已在 new 时物化（appkit sync 可随 appkit 升级刷新）；
# 本地联调先跑 appkit dev（生成 go.work）。

GO ?= go
DEV_DB_URL := postgres://postgres:dev@127.0.0.1:54329/{{.Name}}_dev?sslmode=disable

# CLI 使用独立工具 module，不把 CLI 的额外依赖加入业务 go.mod/go.sum。
# 版本从本仓 go.mod 取，忽略联调 go.work；绝不静默追随 main。
# devel/v0.0.0 占位或未发布源码联调：显式 APPKIT=/绝对路径/已构建appkit；
# 需要已发布工具时显式 APPKIT_VERSION=vX.Y.Z。业务 run/test 的 GOFLAGS 不变。
APPKIT_VERSION ?= $(filter v%,$(shell GOWORK=off $(GO) list -m github.com/forgeplex/appkit 2>/dev/null | awk '{print $$2}'))
APPKIT_FROM_VERSION := $(if $(filter undefined,$(origin APPKIT)),yes,no)
APPKIT ?= GOWORK=off $(GO) run github.com/forgeplex/appkit/cmd/appkit@$(APPKIT_VERSION)
APPKITLINT_VERSION ?= $(APPKIT_VERSION)

.PHONY: run run-minimal dev-db run-db migrate gen schema schema-sqlc schema-check lint check test check-tool-version check-appkit-version

# 正常启动必须有 database.url；缺配置时 fail closed。
run:
	$(GO) run ./cmd/{{.Name}}d

# 零依赖试跑必须显式选择最小模式（仅探针 + /ping）。
run-minimal:
	$(GO) run ./cmd/{{.Name}}d -minimal

# 启动/复用一次性开发 Postgres（docker），与 config/dev.yaml 注释里的地址一致。
dev-db:
	docker start {{.Name}}-dev-pg 2>/dev/null || docker run -d --name {{.Name}}-dev-pg \
		-e POSTGRES_PASSWORD=dev -e POSTGRES_DB={{.Name}}_dev \
		-p 127.0.0.1:54329:5432 postgres:18-alpine
	@until docker exec {{.Name}}-dev-pg pg_isready -U postgres -q; do sleep 0.3; done

# 完整模式一条命令：起开发库 + 以环境变量注入 database.url 起服。
run-db: dev-db
	{{.EnvPrefix}}_DATABASE__URL='$(DEV_DB_URL)' $(GO) run ./cmd/{{.Name}}d

# 只应用迁移然后退出，不监听端口——生产上这一步跑在 initContainer/Job 里，
# 服务副本再起来（见 cmd/{{.Name}}d 的 -migrate）。本地用来单独验证迁移。
migrate: dev-db
	{{.EnvPrefix}}_DATABASE__URL='$(DEV_DB_URL)' $(GO) run ./cmd/{{.Name}}d -migrate

# 重新生成 sqlc 代码（生成物禁手改，CI drift check）。
# 钉版本经 go run 执行，无需预装；本机装了 sqlc 可 SQLC=sqlc make gen。
SQLC ?= $(GO) run github.com/sqlc-dev/sqlc/cmd/sqlc@v1.30.0
gen:
	$(SQLC) generate

# 重新生成 db/SCHEMA.md 与 db/schema/（表结构总览 + ER 图）。改过迁移就跑一次。
# 迁移会被应用到一次性临时库再读回结构，开发库本身不受影响（生成物禁手改）。
schema: check-tool-version dev-db
	$(APPKIT) schema -dsn '$(DEV_DB_URL)'

# 可选 sqlc 快照：TEST_DATABASE_URL 只作为临时库管理连接，不迁移现有库。
# 首次生成后手动把 sqlc.yaml 的 schema 改为 db/schema.sql 并提交快照和 lock。
# 与上面的 schema 文档生成不同；安装工具不改变默认 sqlc 输入。
schema-sqlc:
	$(GO) run ./internal/postgres/schematool -domain {{.Name}}{{if .Partitioned}} -partitioned{{end}}

schema-check:
	$(GO) run ./internal/postgres/schematool -domain {{.Name}}{{if .Partitioned}} -partitioned{{end}} -check

# lint：golangci-lint（depguard 等）+ go-arch-lint（组件依赖矩阵）。
# 配置由 appkit sync 物化，勿手改；版本与 CI 钉在同一个，本地绿 = CI 绿。
# 钉版本经 go run 执行，无需预装；本机装了可 GOLANGCI=golangci-lint make lint。
GOLANGCI ?= $(GO) run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@{{.GolangciVersion}}
ARCHLINT ?= $(GO) run github.com/fe3dback/go-arch-lint@{{.ArchLintVersion}}
# appkit-lint 是嵌套 module（不进业务依赖图），@版本直接拉取。版本随
# go.mod 钉的 appkit——与 CLI、domain-ci.yml 同版，禁止静默追随 main。
lint: check-appkit-version
	@test '$(APPKITLINT_VERSION)' = '$(APPKIT_VERSION)' || { echo "APPKITLINT_VERSION 必须与 APPKIT_VERSION 相同" >&2; exit 1; }
	$(GOLANGCI) run ./...
	$(ARCHLINT) check
	GOWORK=off $(GO) run github.com/forgeplex/appkit/lint/cmd/appkit-lint@$(APPKITLINT_VERSION) ./...

# appkit 架构检查：依赖方向、go.mod require 清单、SQL 跨 schema 引用。
check: check-tool-version
	$(APPKIT) check

test:
	$(GO) test ./...

check-appkit-version:
	@if [ -z "$(APPKIT_VERSION)" ]; then echo "APPKIT_VERSION / APPKITLINT_VERSION 为空：请显式指定已发布版本" >&2; exit 1; fi
	@printf '%s\n' '$(APPKIT_VERSION)' | LC_ALL=C grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$$' || { echo "APPKIT_VERSION 必须为固定版本，禁止 branch/main" >&2; exit 1; }

ifeq ($(APPKIT_FROM_VERSION),yes)
check-tool-version: check-appkit-version
else
check-tool-version:
	@test -n '$(strip $(APPKIT))' || { echo "显式 APPKIT 命令不能为空" >&2; exit 1; }
endif
