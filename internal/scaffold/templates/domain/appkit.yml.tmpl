# appkit 框架配置：appkit sync / check / dev 读取。
version: 1
kind: domain
domain: {{.Name}}
module: {{.Module}}
{{- if .Partitioned}}
# 分区域域：一套代码、N 份数据分区（schema 由调用方经分区键路由）。
# 分区映射由组合根注入（不在本文件）；appkit schema 自动生成 logical-template。
# 无前缀迁移只在代表 schema 回放一遍，未枚举或检查运行时分区。
partitioned: true
{{- end}}
# 合约 module（如 github.com/forgeplex/psp-contracts/go），可空。
contracts: ""
# 额外放行的 forgeplex module（域 repo 之间禁止互相 require，DESIGN §1）。
allowRequires: []
