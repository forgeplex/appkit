// Package module 是装配层：把业务包、postgres、http、inbox 装进
// appkit.Registry。这是本仓库唯一的 wiring 落点——驱动类型（连接池）
// 从组合根注入，到此为止，不再向业务包扩散。
//
// 分区 + 行级双层隔离（partitioned + tenant）：一套代码、N 份数据分区，
// 每个分区内再按 tenant_id 行级隔离——「运营平台 + 多商户、每个平台一套
// 数据」的形态（docs/TENANTS.md）。两个维度各走各的字段：分区键
// （callctx.Meta.Partition，authn.MultiIssuer 按令牌签发方焊入）决定事务
// 路由到哪个 schema，租户（callctx.Meta.TenantID，令牌 tid）决定 RLS 放开
// 哪些行。运营的跨租户读路径用 tx.WithReadAllTenants（只放开 SELECT，
// 且只在本分区内）。
package module

import (
	"context"
	"fmt"
	"io/fs"
	"log/slog"
	"net/http"

	"github.com/jackc/pgx/v5/pgxpool"

	"github.com/forgeplex/appkit"
	"github.com/forgeplex/appkit/apperr"
	"github.com/forgeplex/appkit/callctx"
	"github.com/forgeplex/appkit/health"
	"github.com/forgeplex/appkit/outbox"
	"github.com/forgeplex/appkit/pgtx"

	"{{.Module}}/internal/{{.Name}}"
	{{.Name}}http "{{.Module}}/internal/http"
	"{{.Module}}/internal/postgres"
)

// Options 是装配期依赖，由组合根注入（连接池按数据库共享，DESIGN §8）。
type Options struct {
	Log  *slog.Logger
	Pool *pgxpool.Pool
	// Bus 是事件总线（单体单库用 outbox.NewDirectBus()，拆分部署换 NATS/Kafka
	// 实现）。非 nil 时每个分区一个 outbox relay：本域事件自动外发。
	// 组合根应把同一个实例传给全部模块并注入 appkit.Bus(bus)。
	Bus outbox.Bus
	// Schemas 是分区映射：已验证 principal 重建到 callctx.Meta.Partition 的
	// 分区键（authn.MultiIssuer 按令牌签发方决定）到本域的数据分区 schema。
	// unsigned X-Partition 只承载传输值，严格安全模式不会信任它。
	// 映射定义放组合根自己的配置文件
	// （koanf 原生支持 map[string]string），由组合根读取后注入——本仓库不
	// 暗读全局配置。每个分区内的租户（tenant_id）是另一个维度，不在这里：
	//   {"a": "{{.Name}}_a", "b": "{{.Name}}_b"}
	// 新分区 = 映射加一条 + 重启：迁移自动建出 schema 并应用同一份无前缀 DDL，
	// 零手写 SQL。
	Schemas map[string]string
}

// New 构造模块。migrations 是 db/migrations 的 embed FS（由根包注入）。
func New(opts Options, migrations fs.FS) appkit.Module {
	return &mod{opts: opts, migrations: migrations}
}

type mod struct {
	opts       Options
	migrations fs.FS
	// handler 在 Setup 阶段装配（依赖解析之后）；Mount 必须发生在 Register
	// 阶段，因此路由经一层间接引用——Setup 先于 HTTP 监听，不会打到 nil。
	handler http.Handler
}

func (m *mod) Name() string { return "{{.Name}}" }

// routePartition 从调用的分区键解析本次落位的分区 schema。查无分区必须
// 响亮失败（422）：静默落到默认 search_path 上只会让最里面那条查询报
// 「表不存在」，错误原因离真正的错处隔了三层。
func routePartition(ctx context.Context, schemas map[string]string) (string, error) {
	partition := callctx.From(ctx).Partition
	schema, ok := schemas[partition]
	if !ok {
		return "", apperr.InvalidArgument(
			"未知分区 %q——请求没有已验证的分区身份（authn.MultiIssuer），或组合根未注入该分区映射", partition)
	}
	return schema, nil
}

// routedPublisher 按当前调用的分区落表：事件与业务写同事务、同分区，
// relay 再按分区外发。业务包依赖的单方法接口形态不变。
type routedPublisher struct {
	pool    *pgxpool.Pool
	schemas map[string]string
}

func (p *routedPublisher) Publish(ctx context.Context, evt appkit.Event) error {
	schema, err := routePartition(ctx, p.schemas)
	if err != nil {
		return err
	}
	return outbox.Publish(ctx, pgtx.From(ctx, p.pool), schema, evt)
}

// Register 只做声明：Provide 服务、登记迁移 / 路由 / 健康检查（DESIGN §5.1）。
func (m *mod) Register(reg *appkit.Registry) error {
	if len(m.opts.Schemas) == 0 {
		return fmt.Errorf("{{.Name}}: Options.Schemas 为空——分区域域必须由组合根注入分区映射（分区键 → schema）")
	}
	// 双层 Transactor：每次 Do 先 SET LOCAL search_path 到当前分区，再把
	// callctx 里的租户身份落成事务级 GUC（app.tenant_id）。分区内业务表的
	// RLS 策略读它过滤行；事务外 pgtx.From 落在默认 search_path 上，无前缀
	// 表不存在即报错——两层的失败都响亮。
	txr := pgtx.NewRoutedTenant(m.opts.Pool, func(ctx context.Context) (string, error) {
		return routePartition(ctx, m.opts.Schemas)
	})
	appkit.Provide(reg, func(*appkit.Registry) (*{{.Name}}.Service, error) {
		return {{.Name}}.NewService(
			postgres.NewStore(m.opts.Pool),
			txr,
			&routedPublisher{pool: m.opts.Pool, schemas: m.opts.Schemas},
		), nil
	})
	// 对外契约（psp-contracts 生成后）改用 appkit.ProvideContract +
	// 生成的 wrapper 注册：每次跨模块调用都经 contract.Call（DESIGN §5.3）。

	// 迁移：同一份无前缀 FS 应用到每个分区；schema 不存在时 pgmigrate 自动
	// 创建——新分区零手写 SQL。
	for _, schema := range m.opts.Schemas {
		reg.Migrations(schema, m.migrations)
	}

	// 权限码声明（应用级目录，与数据分区无关）：汇总进全应用目录，鉴权
	// 提供方（如 rbac）据此同步落库。根路由绑码用
	// reg.MountPermission("POST /...", {{.Name}}.PermRead, handler)；模块内部
	// 子 mux 才用 reg.Require。验签中间件是组合根职责。跨租户码（运营看本分区全部
	// 商户）与普通码同机制，只是授予面不同。
	reg.Permissions({{.Name}}.PermissionCatalog()...)

	reg.Setup(func(ctx context.Context) error {
		// 迁移已应用（Setup 晚于迁移），逐分区校验租户隔离的完整性：
		// 有 tenant_id 列的表必须 ENABLE+FORCE+两条策略齐全，且连接角色不得
		// superuser/BYPASSRLS——否则 RLS 静默不生效，等于裸奔。缺一样
		// 都拒绝启动，错误信息点名分区与表并附修复 SQL。
		for partition, schema := range m.opts.Schemas {
			if err := pgtx.VerifyTenantRLS(ctx, m.opts.Pool, schema); err != nil {
				return fmt.Errorf("{{.Name}}: 分区 %q: %w", partition, err)
			}
		}
		svc := appkit.MustResolve[*{{.Name}}.Service](reg)
		m.handler = {{.Name}}http.NewPingHandler(m.opts.Log, svc)
		// 消费外域事件样例（声明后组合根必须以 appkit.Bus 注入总线）。
		// 分区域域的 dedup 表（inbox）随分区一套：消费者按「这个 topic 的事件
		// 落在哪个分区」登记，handler 内按事件 meta 的分区键与租户路由（callctx
		// 已沿事件传播）：
		// reg.Consumer("other.something.v1",
		//     outbox.Inbox(m.opts.Pool, m.opts.Schemas["a"], inbox.Consumer, inbox.NewHandler(svc)))
		return nil
	})
	reg.MountPublic({{.Name}}http.PingPattern, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		m.handler.ServeHTTP(w, r)
	}))

	reg.Health("postgres", health.CheckFunc(func(ctx context.Context) error {
		return m.opts.Pool.Ping(ctx)
	}))

	// outbox relay 每分区一个：轮询该分区的 outbox 表并经 Bus 外发
	// （退避/死信见 outbox 包文档）。reg.Worker 管住 goroutine 的三件事——
	// 关停等它退出、超预算不吊死、崩了掀翻进程而不是让探针继续绿着——
	// 都在框架里，这里只交一个函数。
	if m.opts.Bus != nil {
		for partition, schema := range m.opts.Schemas {
			relay := outbox.NewRelay(m.opts.Pool, schema, m.opts.Bus)
			reg.Worker("outbox-relay/"+partition, relay.Run)
		}
	} else {
		m.opts.Log.Warn("{{.Name}}: 未注入 Bus，outbox relay 未启动——本域事件只落表不外发")
	}
	return nil
}
