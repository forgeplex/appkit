# sqlc 配置：make gen 生成 internal/postgres/sqlc（生成物禁手改，CI drift check）。
{{- if .Partitioned}}
# 分区域域：迁移与查询全无前缀，sqlc 在「无前缀世界」里静态自洽；
# 落位发生在运行期（事务级 search_path 路由），sqlc 不参与。
{{- else}}
# 本域独占 schema "{{.Name}}"：查询与迁移只允许操作该 schema（appkit check 扫描）。
{{- end}}
version: "2"
sql:
  - engine: "postgresql"
    # 首次 make schema-sqlc 后可切为 db/schema.sql；迁移仍是唯一事实源。
    schema: "db/migrations"
    queries: "db/queries"
    gen:
      go:
        package: "sqlc"
        out: "internal/postgres/sqlc"
        sql_package: "pgx/v5"
        emit_interface: true
        overrides:
          # 金额列一律 NUMERIC ↔ decimal.Decimal（全系统禁 float，DESIGN §2）。
          #   - 不用 money.Money：它不实现 pgx/database-sql 编解码接口，且单个
          #     NUMERIC 列还原不了币种——生成代码一碰金额列就在运行期
          #     "cannot scan numeric (OID 1700)"，编译期无感。decimal.Decimal
          #     经 driver.Valuer/sql.Scanner 由 pgx 原生处理，无需注册 codec
          #     （pgxmoney 已废弃）。真库机检见 internal/scaffold 的
          #     TestDomainNumericOverrideRoundTrips。
          #   - 全局而非列级：数组参数（@amounts::numeric[]）与算术结果列
          #     （posted + sqlc.arg(x)）没有列名可匹配，列级 override 会漏。
          #   币种与标度（USD=2、USDT=6…）属业务知识，落资产注册表之类的表；
          #     JSON/合约边界金额一律字符串。首个金额列生成后 go mod tidy
          #     会带上 shopspring/decimal。
          - db_type: "pg_catalog.numeric"
            go_type: "github.com/shopspring/decimal.Decimal"
